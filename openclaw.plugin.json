{
  "id": "webex",
  "name": "Webex Channel",
  "description": "Cisco Webex messaging integration for OpenClaw",
  "channels": [
    "webex"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "description": "Enable the Webex channel",
        "default": false
      },
      "token": {
        "type": "string",
        "description": "Webex bot access token from developer.webex.com"
      },
      "dmPolicy": {
        "type": "string",
        "enum": [
          "allow",
          "deny",
          "allowlisted",
          "pairing"
        ],
        "description": "Policy for handling direct messages",
        "default": "deny"
      },
      "allowFrom": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of allowed person IDs or emails (when dmPolicy is allowlisted)"
      },
      "apiBaseUrl": {
        "type": "string",
        "description": "Custom Webex API base URL",
        "default": "https://webexapis.com/v1"
      },
      "maxRetries": {
        "type": "number",
        "description": "Maximum retry attempts for failed API calls",
        "default": 3
      },
      "retryDelayMs": {
        "type": "number",
        "description": "Delay between retries in milliseconds",
        "default": 1000
      },
      "agent": {
        "type": "string",
        "description": "OpenClaw agent id this account dispatches to. Defaults to \"main\". Set to a specific agent id when running multiple bots on the same gateway, each routed to a different agent."
      },
      "progressStreamReasoning": {
        "type": "boolean",
        "description": "When true, stream the agent's reasoning text live into the Webex progress message instead of the static \"\ud83d\udcad Thinking\u2026\" label. Opt-in because raw reasoning occasionally contains internal deliberation or echoed context users didn't intend to see; redaction is best-effort.",
        "default": false
      },
      "aiopsApprovalUrl": {
        "type": "string",
        "description": "Base URL for the AIOps dashboard's approval API, used to record approve/reject decisions submitted from AIOps approval cards.",
        "default": "http://127.0.0.1:8765/api/v1"
      },
      "aiopsApprovalSecret": {
        "type": "string",
        "description": "Optional shared secret sent as the X-AIOps-Approval-Secret header on every approval/rejection request to the AIOps dashboard."
      },
      "progressVerbosity": {
        "type": "string",
        "enum": [
          "silent",
          "minimal",
          "detailed"
        ]
      },
      "progressHeartbeatMs": {
        "type": "number"
      },
      "showProgressPlaceholder": {
        "type": "boolean"
      },
      "progressPlaceholderText": {
        "type": "string"
      },
      "accounts": {
        "type": "object",
        "description": "Named webex bot accounts. Each entry is a separate bot with its own token/webhookUrl, optionally routed to a different agent.",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "token": {
              "type": "string"
            },
            "dmPolicy": {
              "type": "string",
              "enum": [
                "allow",
                "deny",
                "allowlisted",
                "pairing"
              ]
            },
            "allowFrom": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "agent": {
              "type": "string"
            },
            "apiBaseUrl": {
              "type": "string"
            },
            "maxRetries": {
              "type": "number"
            },
            "retryDelayMs": {
              "type": "number"
            },
            "progressVerbosity": {
              "type": "string",
              "enum": [
                "silent",
                "minimal",
                "detailed"
              ]
            },
            "progressHeartbeatMs": {
              "type": "number"
            },
            "progressStreamReasoning": {
              "type": "boolean"
            },
            "aiopsApprovalUrl": {
              "type": "string"
            },
            "aiopsApprovalSecret": {
              "type": "string"
            },
            "showProgressPlaceholder": {
              "type": "boolean"
            },
            "progressPlaceholderText": {
              "type": "string"
            }
          },
          "required": [
            "token"
          ]
        }
      }
    },
    "anyOf": [
      {
        "required": [
          "token"
        ]
      },
      {
        "required": [
          "accounts"
        ]
      }
    ]
  },
